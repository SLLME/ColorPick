.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 200rpx 60rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 130rpx;
  color: #D0D0D6;
  line-height: 1;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: var(--c-sub);
  line-height: 1.7;
}

.empty-btn {
  margin-top: 56rpx;
  width: 100%;
}

/* ---------- 概览 ---------- */
.overview {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 12rpx 8rpx 28rpx;
}

.ov-num {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--c-primary);
}

.ov-label {
  font-size: 26rpx;
  color: var(--c-sub);
  flex: 1;
}

.ov-actions {
  display: flex;
  gap: 28rpx;
}

.ov-link {
  font-size: 25rpx;
  color: var(--c-primary);
}

.ov-link.danger {
  color: #8A8A8E;
}

/* ---------- 网格 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
}

.grid-item {
  width: calc((100% - 44rpx) / 3);
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--c-card);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.grid-swatch {
  height: 150rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 12rpx;
}

.grid-hex {
  font-size: 19rpx;
  opacity: 0.9;
}

.grid-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 16rpx;
  gap: 8rpx;
}

.grid-name {
  font-size: 23rpx;
  color: var(--c-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  flex: 1;
}

.grid-del {
  font-size: 21rpx;
  color: #B0B0B6;
  flex-shrink: 0;
}

.hint {
  margin-top: 36rpx;
  text-align: center;
  font-size: 23rpx;
  color: #B0B0B6;
}

/* ---------- 详情弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 88vh;
  background: var(--c-bg);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sheet-swatch {
  height: 260rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-hex {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.sheet-body {
  flex: 1;
  overflow-y: auto;
  padding: 28rpx;
}

.sheet-name {
  background: var(--c-card);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.fmt-list {
  background: var(--c-card);
  border-radius: 20rpx;
  padding: 8rpx 26rpx;
  margin-bottom: 32rpx;
}

.fmt-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--c-line);
}

.fmt-item:last-child {
  border-bottom: none;
}

.fmt-label {
  width: 120rpx;
  font-size: 26rpx;
  color: var(--c-sub);
  flex-shrink: 0;
}

.fmt-val {
  flex: 1;
  font-size: 26rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.fmt-copy {
  font-size: 24rpx;
  color: var(--c-primary);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.sub-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.harmony {
  margin-bottom: 30rpx;
}

.harmony-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.harmony-name {
  font-size: 26rpx;
  font-weight: 600;
}

.harmony-desc {
  font-size: 22rpx;
  color: var(--c-sub);
}

.harmony-strip {
  display: flex;
  gap: 10rpx;
}

.harmony-chip {
  flex: 1;
  height: 100rpx;
  border-radius: 14rpx;
  font-size: 19rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 10rpx;
  font-family: "SF Mono", Menlo, monospace;
  box-shadow: inset 0 0 0 2rpx rgba(0, 0, 0, 0.05);
}

.sheet-btns {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--c-card);
  flex-shrink: 0;
}

.flex1 {
  flex: 1;
}
